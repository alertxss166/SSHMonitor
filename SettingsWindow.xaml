<Window x:Class="SSHMonitor.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Monitor settings" Width="820" Height="590" WindowStartupLocation="CenterOwner" Background="#0B0F14" Foreground="#E6EDF3" Icon="{StaticResource AppIcon}">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1117"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="CaretBrush" Value="#E6EDF3"/>
      <Setter Property="BorderBrush" Value="#303B47"/>
      <Setter Property="SelectionBrush" Value="#1F6FEB"/>
      <Setter Property="Padding" Value="9,7"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#17212B"/>
      <Setter Property="Foreground" Value="#AFC7DD"/>
      <Setter Property="BorderBrush" Value="#303B47"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="BorderBrush" Value="#26313D"/>
      <Setter Property="Padding" Value="7,4"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#163A5F"/><Setter Property="Foreground" Value="White"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="5"><TextBlock x:Name="ProfileNameLabel" Text="PROFILE NAME" Foreground="#8FBCE6" Margin="0,0,0,6"/><TextBox x:Name="NameBox"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="5"><TextBlock x:Name="RefreshLabel" Text="REFRESH SECONDS" Foreground="#8FBCE6" Margin="0,0,0,6"/><TextBox x:Name="RefreshBox"/></StackPanel>
    </Grid>
    <DataGrid Grid.Row="1" x:Name="ChecksGrid" Margin="5,18" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" Background="#111820" Foreground="#E6EDF3" RowBackground="#111820" AlternatingRowBackground="#16202A" BorderBrush="#303B47" HorizontalGridLinesBrush="#26313D" VerticalGridLinesBrush="#26313D" RowHeaderWidth="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="130" x:Name="TypeColumn"/>
        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="5,0,5,14"><Button x:Name="AddCheckButton" Content="＋ Add check" Padding="16,9" Background="#1F6FEB" Foreground="White" FontWeight="SemiBold"/><Button x:Name="RemoveCheckButton" Content="Remove selected" Padding="14,9" Margin="8,0"/><TextBlock x:Name="AddHint" Text="Add a service, URL, port, process or container" VerticalAlignment="Center" Foreground="#8B98A5" Margin="8,0"/></StackPanel>
      <DockPanel Grid.Row="1"><Button x:Name="KeyButton" Content="Choose private key (optional)" Padding="12,8" DockPanel.Dock="Left"/><TextBlock x:Name="KeyText" VerticalAlignment="Center" Margin="10,0" Foreground="#8B98A5" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" Padding="15,8"/><Button x:Name="SaveButton" Content="Save" Padding="15,8" Background="#238636" Foreground="White"/></StackPanel></DockPanel>
    </Grid>
  </Grid>
</Window>
