<Window x:Class="SSHMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Monitor" Width="1040" Height="700" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#0B0F14" Foreground="#E6EDF3" FontFamily="Segoe UI" Icon="{StaticResource AppIcon}">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#111820"/>
    <SolidColorBrush x:Key="Border" Color="#26313D"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#238636"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="5"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1117"/><Setter Property="Foreground" Value="#E6EDF3"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="9"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0D1117"/><Setter Property="Foreground" Value="#E6EDF3"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="9"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="6"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#8B98A5"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#8B98A5"/><Setter Property="Background" Value="#111820"/><Setter Property="BorderBrush" Value="#26313D"/><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="6,0,2,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#58A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
    <Style x:Key="LogBox" TargetType="TextBox"><Setter Property="Background" Value="#0D1117"/><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="BorderBrush" Value="#26313D"/><Setter Property="FontFamily" Value="Cascadia Mono,Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="12"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="6,2,6,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Image Source="{StaticResource AppIcon}" Width="40" Height="40" Margin="0,0,12,0"/><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="SSH MONITOR" FontSize="24" FontWeight="Bold"/><Border Background="#17212B" CornerRadius="4" Padding="7,2" Margin="10,4,0,4"><TextBlock x:Name="VersionText" Text="v0.1.0" Foreground="#8FBCE6" FontSize="11" VerticalAlignment="Center"/></Border></StackPanel><TextBlock x:Name="Subtitle" Text="Private, agentless Linux monitoring over SSH" Style="{StaticResource Muted}"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="LanguageBox" Width="94" Height="34" Margin="5" Background="#17202A" Foreground="#E6EDF3" SelectedIndex="0"><ComboBoxItem Tag="en">EN</ComboBoxItem><ComboBoxItem Tag="ru">RU</ComboBoxItem><ComboBoxItem Tag="zh">中文</ComboBoxItem></ComboBox><Button x:Name="SettingsButton" Content="Checks &amp; settings" Background="#303B47"/><Button x:Name="ConnectButton" Content="Connect"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="5"><TextBlock x:Name="HostLabel" Text="HOST" Style="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="HostBox"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="5"><TextBlock x:Name="PortLabel" Text="PORT" Style="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="PortBox"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="5"><TextBlock x:Name="UserLabel" Text="USER" Style="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="UserBox"/></StackPanel>
        <StackPanel Grid.Column="3" Margin="5"><TextBlock x:Name="PasswordLabel" Text="PASSWORD" Style="{StaticResource Muted}" FontSize="11"/><PasswordBox x:Name="PasswordBox" ToolTip="Kept in memory only"/></StackPanel>
        <StackPanel Grid.Column="4" Margin="12,5,5,5" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="● Offline" Foreground="#8B98A5" FontWeight="SemiBold"/></StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="2" Margin="0,6,0,0">
      <TabItem x:Name="OverviewTab" Header="Overview">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="3">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="UptimeLabel" Text="UPTIME" Style="{StaticResource Muted}"/><TextBlock x:Name="UptimeText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="MemoryLabel" Text="MEMORY" Style="{StaticResource Muted}"/><TextBlock x:Name="MemoryText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="LoadLabel" Text="LOAD  1m / 5m / 15m" Style="{StaticResource Muted}"/><TextBlock x:Name="LoadText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ServerLabel" Text="SERVER" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF"/><TextBlock x:Name="ServerText" Text="Connect to see server details" FontSize="17" Margin="0,14,0,10"/><TextBlock x:Name="RootDiskLabel" Text="ROOT DISK" Style="{StaticResource Muted}"/><ProgressBar x:Name="DiskBar" Height="12" Margin="0,8,0,5" Maximum="100"/><TextBlock x:Name="DiskText" Text="—" Style="{StaticResource Muted}"/><TextBlock x:Name="PrivacyText" Text="No inbound agent, public dashboard, or open monitoring port is required." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,28,0,0"/></StackPanel></Border>
      </Grid>
      <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChecksLabel" Text="CHECKS" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" VerticalAlignment="Center"/><Button x:Name="AddCheckButton" Grid.Column="1" Content="＋ Add check" Background="#1F6FEB" FontWeight="SemiBold"/></Grid><TextBlock x:Name="ChecksHintText" Text="Services, URLs, ports, processes and containers" Style="{StaticResource Muted}" Margin="0,3,0,14"/></StackPanel><ListBox x:Name="ChecksList" Background="Transparent" BorderThickness="0" Foreground="#E6EDF3"/></DockPanel></Border>
    </Grid></TabItem>
      <TabItem x:Name="AdditionalTab" Header="Advanced">
        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="ConnectionsTitle" Text="ACTIVE CONNECTIONS" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF"/><TextBlock x:Name="ConnectionsHint" Text="Current TCP connections reported by the server" Style="{StaticResource Muted}" Margin="0,3,0,12"/></StackPanel><TextBox x:Name="ConnectionsText" Style="{StaticResource LogBox}" Text="Connect to collect data"/></DockPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="SecurityTitle" Text="SSH / FIREWALL" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF"/><TextBlock x:Name="SecurityHint" Text="Recent authentication and firewall events" Style="{StaticResource Muted}" Margin="0,3,0,12"/></StackPanel><TextBox x:Name="SecurityText" Style="{StaticResource LogBox}" Text="Connect to collect data"/></DockPanel></Border>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="3" x:Name="FooterText" Text="Passwords are never saved. Configure a dedicated read-only monitoring account." Style="{StaticResource Muted}" Margin="8,8,8,0"/>
  </Grid>
</Window>
