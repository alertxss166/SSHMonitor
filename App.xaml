<Application x:Class="SSHMonitor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <DrawingImage x:Key="AppIcon">
      <DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#0D1117" Geometry="M0,0 H64 V64 H0 Z"/>
        <GeometryDrawing Brush="#1F6FEB" Geometry="M8,10 H56 Q58,10 58,12 V52 Q58,54 56,54 H8 Q6,54 6,52 V12 Q6,10 8,10 Z"/>
        <GeometryDrawing Brush="#0D1117" Geometry="M11,16 H53 V48 H11 Z"/>
        <GeometryDrawing Brush="#58A6FF" Geometry="M16,23 L23,30 16,37 19,40 29,30 19,20 Z"/>
        <GeometryDrawing Brush="#3FB950" Geometry="M30,39 H47 V43 H30 Z"/>
      </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="Background" Value="#111820"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1F6FEB"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#163A5F"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#111820"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="BorderBrush" Value="#303B47"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="OuterBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Path Grid.Column="1" Data="M 1 3 L 5 7 L 9 3" Stroke="#8FBCE6" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="#111820" BorderBrush="#303B47" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OuterBorder" Property="BorderBrush" Value="#58A6FF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
